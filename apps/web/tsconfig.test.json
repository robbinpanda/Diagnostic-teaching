{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "noEmit": false,
    "outDir": "./dist/test",
    "rootDir": "."
  },
  "include": [
    "lib/api.ts",
    "lib/audio.ts",
    "lib/image-draft-recovery.ts",
    "lib/speech-text.ts",
    "lib/model-test-concurrency.ts",
    "lib/session-workflow.ts",
    "lib/stream-controller.ts",
    "lib/stream-protocol.ts",
    "lib/timeline.ts",
    "components/MathText.tsx",
    "components/CheckpointModal.tsx",
    "components/StudyCardModal.tsx",
    "components/workspace/ConversationHeader.tsx",
    "components/workspace/MessageTimeline.tsx",
    "components/workspace/ModelProfilePicker.tsx",
    "components/workspace/SessionSidebar.tsx",
    "components/workspace/StudyCardSidebar.tsx",
    "tests/**/*.test.ts",
    "tests/**/*.test.tsx"
  ],
  "exclude": ["node_modules", ".next"]
}
